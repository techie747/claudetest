# ── Frequency Intelligence Engine — Environment Config ──────────────────────

# Suno API key (required for music generation)
# Get yours at: https://suno.com → Account → API / Developer Settings
SUNO_API_KEY=suno-your-api-key-here

# Suno API base URL (default shown — change only if Suno updates their domain)
SUNO_API_BASE=https://api.suno.ai

# Comma-separated list of allowed origins for widget embedding
# Use * to allow all origins, or list specific domains:
# ALLOWED_ORIGINS=https://mysite.com,https://app.mysite.com
ALLOWED_ORIGINS=*

# Web server port (default: 3000)
PORT=3000
